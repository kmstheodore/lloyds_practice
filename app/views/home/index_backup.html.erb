<div data-controller="pill-nav" class="min-h-screen bg-[#F3F4F3] text-[#141716] pb-24">
  <div class="max-w-md mx-auto">

    <!-- Top Header for Home / Pill Tabs -->
    <header data-pill-nav-target="panel" data-tab="home-header" class="sticky top-0 z-20 bg-[#F3F4F3]/95 backdrop-blur px-4 pt-4 pb-3 border-b border-black/5">
      <div class="flex items-center justify-between mb-4">
        <button type="button" class="p-1 text-[#141716]" aria-label="Messages">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10l2.4-6h13.2L21 10M3 10h5l1.5 3h5L16 10h5M3 10v8a2 2 0 002 2h14a2 2 0 002-2v-8" />
          </svg>
        </button>

        <h1 class="text-xl font-bold tracking-tight">Good afternoon Theodore</h1>

        <button type="button" class="p-1 text-[#141716]" aria-label="Profile settings">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 7.5a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.118a7.5 7.5 0 0115 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </button>
      </div>

      <% pills = [
        { key: "summary", label: "Summary", active: true },
        { key: "everyday", label: "Everyday", active: false },
        { key: "save_invest", label: "Save & Invest", active: false },
        { key: "borrow", label: "Borrow", active: false },
        { key: "homes", label: "Homes", active: false },
        { key: "insure", label: "Insure", active: false }
      ] %>

      <div class="-mx-4 px-4 overflow-x-auto no-scrollbar scroll-smooth">
        <div class="flex items-center gap-2.5 w-max pr-4">
          <% pills.each do |pill| %>
            <button
              type="button"
              data-tab="<%= pill[:key] %>"
              data-pill-nav-target="pill"
              data-action="click->pill-nav#select"
              class="shrink-0 h-11 px-5 rounded-full border text-sm font-semibold whitespace-nowrap transition-colors <%= pill[:active] ? 'bg-[#141716] text-white border-[#141716]' : 'bg-white text-[#141716] border-[#2A2F2D]' %>">
              <%= pill[:label] %>
            </button>
          <% end %>
        </div>
      </div>
    </header>

    <!-- SUMMARY TAB VIEW -->
    <main data-pill-nav-target="panel" data-tab="summary" class="px-4 pt-4 space-y-4">

      <section class="bg-white rounded-2xl shadow-xs border border-black/5 overflow-hidden">
        <div class="p-4">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold">Everyday</h2>
            <span class="text-xl text-[#141716]">&rarr;</span>
          </div>

          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-lg border border-gray-200 flex items-center justify-center text-lg shrink-0">
                🐎
              </div>
              <div>
                <p class="text-sm font-bold leading-snug"><%= @account.name %></p>
                <p class="text-xs text-[#5C6260] leading-snug tabular-nums"><%= @account.sort_code %> /</p>
                <p class="text-xs text-[#5C6260] leading-snug tabular-nums"><%= @account.account_number %></p>
              </div>
            </div>

            <p class="text-xl font-extrabold tracking-tight tabular-nums whitespace-nowrap">
              <%= gbp(@account.balance) %>
            </p>
          </div>
        </div>

        <a href="#premier" class="flex items-center justify-between px-4 py-3.5 border-t border-gray-200 text-sm font-semibold hover:bg-gray-50">
          <span>Upgrade to Lloyds Premier now</span>
          <span class="text-lg">&rarr;</span>
        </a>
      </section>

      <section class="bg-white rounded-2xl p-4 shadow-xs border border-black/5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3.5">
          <div class="w-14 h-14 rounded-xl bg-[#E8F7EE] text-[#00875A] flex items-center justify-center text-2xl shrink-0">
            🪙
          </div>
          <div>
            <h3 class="text-base font-bold leading-snug">Banking and beyond</h3>
            <p class="text-sm text-[#5C6260] leading-snug mt-0.5">
              New ways to boost, borrow and balance your money
            </p>
          </div>
        </div>
        <span class="text-[#141716] text-lg shrink-0">&rsaquo;</span>
      </section>

      <section class="bg-white rounded-2xl p-4 shadow-xs border border-black/5">
        <div class="flex items-center gap-1.5 mb-3">
          <h3 class="text-base font-bold">Rewards</h3>
          <span class="px-2.5 py-0.5 rounded-full bg-[#00875A] text-white text-[11px] font-bold tracking-wide">
            <%= @account.rewards_count %> NEW
          </span>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex -space-x-2 shrink-0">
            <span class="w-10 h-10 rounded-full bg-black text-amber-300 text-[10px] font-bold flex items-center justify-center ring-2 ring-white">AM</span>
            <span class="w-10 h-10 rounded-full bg-[#24476B] text-white text-[9px] font-bold flex items-center justify-center ring-2 ring-white">RANDO</span>
            <span class="w-10 h-10 rounded-full bg-white text-[#0668E1] text-[10px] font-extrabold flex items-center justify-center ring-2 ring-white border border-gray-200">∞</span>
          </div>
          <p class="text-sm text-[#5C6260] leading-snug">
            Get rewards, cashback, benefits and more.
          </p>
        </div>
      </section>

      <section class="bg-[#56C271] rounded-2xl p-5 text-[#141716] flex items-center justify-between gap-3 shadow-xs">
        <div class="space-y-2 max-w-[65%]">
          <h3 class="text-lg font-extrabold leading-snug">Future you says thanks</h3>
          <p class="text-sm leading-snug font-medium">
            Lock in Life Cover early. It's not just for the boomers.
          </p>
        </div>

        <div class="w-20 h-20 rounded-full bg-white/30 flex items-center justify-center text-3xl shrink-0">
          🌱
        </div>
      </section>

      <section class="bg-white rounded-2xl p-4 shadow-xs border border-black/5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-14 rounded-lg bg-[#141716] text-white flex flex-col items-center justify-center px-1 shrink-0">
            <span class="text-xs font-extrabold tracking-tight leading-none">fscs</span>
            <span class="text-[8px] font-bold uppercase tracking-wider mt-1">PROTECTED</span>
          </div>
          <p class="text-sm text-[#5C6260] leading-snug">
            See how your money is protected
          </p>
        </div>
        <span class="text-[#141716] text-lg shrink-0">&rsaquo;</span>
      </section>

      <div class="pt-2 pb-1 flex justify-center">
        <button type="button" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-[#141716] bg-[#F3F4F3] text-sm font-bold hover:bg-white">
          <span>Customise</span>
          <span>✎</span>
        </button>
      </div>

      <footer class="pt-4 pb-6 text-center space-y-2 text-[#5C6260]">
        <div class="text-3xl text-[#006A4D]">🐎</div>
        <p class="text-sm font-medium">All caught up</p>
      </footer>

    </main>

    <!-- EVERYDAY TAB VIEW -->
    <main data-pill-nav-target="panel" data-tab="everyday" class="hidden px-4 pt-4 space-y-4">

      <section aria-labelledby="current-accounts-heading">
        <h2 id="current-accounts-heading" class="text-lg font-bold mb-3">Current accounts</h2>

        <div class="bg-white rounded-2xl shadow-xs border border-black/5 overflow-hidden">
          <div class="p-5">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-base font-bold"><%= @account.name %></p>
                <p class="text-sm text-[#5C6260] mt-0.5 tabular-nums">
                  <%= @account.sort_code %> / <%= @account.account_number %>
                </p>
              </div>
              <button type="button" class="text-[#141716] font-bold tracking-widest px-1" aria-label="Account options">
                ···
              </button>
            </div>

            <p class="text-3xl font-extrabold tracking-tight mt-4 tabular-nums">
              <%= gbp(@account.balance) %>
            </p>

            <div class="mt-2 space-y-0.5 text-sm text-[#5C6260] tabular-nums">
              <p>Overdraft limit: <%= gbp(@account.overdraft_limit) %></p>
              <p>Remaining overdraft: <%= gbp(@remaining_overdraft) %></p>
            </div>
          </div>

          <div class="grid grid-cols-2 border-t border-gray-200 divide-x divide-gray-200">
            <button type="button" class="py-3.5 text-sm font-bold text-center hover:bg-gray-50 active:bg-gray-100">
              Pay &amp; transfer
            </button>
            <button type="button" class="py-3.5 text-sm font-bold text-center hover:bg-gray-50 active:bg-gray-100">
              Regular payments
            </button>
          </div>
        </div>
      </section>

      <section class="bg-white rounded-2xl shadow-xs border border-black/5 overflow-hidden">
        <div class="p-6 text-center">
          <div class="mx-auto mb-4 w-24 h-20 flex items-center justify-center rounded-xl bg-[#E8F7EE] text-[#006A4D] font-bold text-xs">
            CARD + PHONE
          </div>
          <h3 class="text-lg font-bold">Helping you manage your money</h3>
          <p class="text-sm text-[#5C6260] mt-1.5 leading-relaxed max-w-xs mx-auto">
            Budget for upcoming bills, spot spending habits and see where you could save.
          </p>
        </div>

        <div class="border-t border-gray-200 divide-y divide-gray-200">
          <a href="#upcoming-payments" class="flex items-center justify-between px-4 py-4 hover:bg-gray-50">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded border border-[#141716] flex items-center justify-center text-xs font-bold">📅</span>
              <span class="text-sm font-semibold">View your upcoming payments</span>
            </div>
            <span class="text-[#141716] text-lg">&rsaquo;</span>
          </a>

          <a href="#spending-insights" class="flex items-center justify-between px-4 py-4 hover:bg-gray-50">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full border border-[#141716] flex items-center justify-center text-xs font-bold">◎</span>
              <span class="text-sm font-semibold">View your spending insights</span>
            </div>
            <span class="text-[#141716] text-lg">&rsaquo;</span>
          </a>
        </div>
      </section>

      <section class="bg-[#56C271] rounded-2xl p-5 text-[#141716] flex items-center justify-between gap-3 shadow-xs">
        <div class="space-y-2.5 max-w-[65%]">
          <h3 class="text-lg font-extrabold leading-snug">Future you says thanks</h3>
          <p class="text-sm leading-snug font-medium">
            Lock in Life Cover early. It's not just for the boomers. £50,000 and 5 years of cover for £5 a month. T&amp;Cs apply.
          </p>
          <a href="#life-cover" class="inline-flex items-center gap-2 pt-1 text-sm font-bold">
            <span>Get covered</span>
            <span class="w-7 h-7 rounded-full bg-[#141716] text-white inline-flex items-center justify-center text-xs">
              &rarr;
            </span>
          </a>
        </div>

        <div class="w-24 h-28 rounded-xl bg-white/30 flex items-center justify-center text-3xl shrink-0">
          🌱
        </div>
      </section>

      <section class="bg-white rounded-2xl p-4 shadow-xs border border-black/5">
        <div class="flex items-center gap-1.5 mb-3">
          <h3 class="text-base font-bold">Rewards</h3>
          <span class="px-2.5 py-0.5 rounded-full bg-[#00875A] text-white text-[11px] font-bold tracking-wide">
            <%= @account.rewards_count %> NEW
          </span>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex -space-x-2 shrink-0">
            <span class="w-10 h-10 rounded-full bg-black text-amber-300 text-[10px] font-bold flex items-center justify-center ring-2 ring-white">AM</span>
            <span class="w-10 h-10 rounded-full bg-[#24476B] text-white text-[9px] font-bold flex items-center justify-center ring-2 ring-white">RANDO</span>
            <span class="w-10 h-10 rounded-full bg-white text-[#0668E1] text-[10px] font-extrabold flex items-center justify-center ring-2 ring-white border border-gray-200">∞</span>
          </div>
          <p class="text-sm text-[#5C6260] leading-snug">
            Get rewards, cashback, benefits and more.
          </p>
        </div>
      </section>

      <section class="bg-white rounded-2xl p-4 shadow-xs border border-black/5 flex items-center justify-between">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-[#00875A] text-white flex items-center justify-center font-bold text-sm shrink-0">
            🐎
          </div>
          <div>
            <h3 class="text-base font-bold">Manage cards</h3>
            <p class="text-sm text-[#5C6260]">View PIN, freeze card and more.</p>
          </div>
        </div>
        <span class="text-[#141716] text-lg">&rsaquo;</span>
      </section>

      <section aria-labelledby="more-for-you-heading">
        <h2 id="more-for-you-heading" class="text-lg font-bold mb-3">More for you</h2>

        <div class="grid grid-cols-2 gap-3">
          <div class="bg-white rounded-2xl p-4 shadow-xs border border-black/5 flex flex-col justify-between min-h-[190px]">
            <div class="w-11 h-11 rounded-full bg-[#FDE6CE] text-[#C86D2D] flex items-center justify-center font-bold">
              🏛
            </div>
            <div class="mt-4">
              <p class="text-sm text-[#5C6260] leading-snug">Got other bank accounts?</p>
              <p class="text-base font-bold leading-snug mt-1">Add them to your app</p>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-4 shadow-xs border border-black/5 flex flex-col justify-between min-h-[190px]">
            <div class="w-11 h-11 rounded-full bg-[#BCE6E6] text-[#1E6B7B] flex items-center justify-center font-bold">
              ✈
            </div>
            <div class="mt-4">
              <p class="text-sm text-[#5C6260] leading-snug">Plan, book, spend, enjoy</p>
              <p class="text-base font-bold leading-snug mt-1">Explore Travel Hub</p>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-white rounded-2xl p-5 shadow-xs border border-black/5 flex items-center justify-between gap-3">
        <div class="space-y-2.5 max-w-[66%]">
          <h3 class="text-lg font-bold leading-snug">Get cover for around £5</h3>
          <p class="text-sm text-[#5C6260] leading-relaxed">
            38% paid £5.49 a month or less for a Bronze contents only policy with no extras from 1 Feb to 31 Jul 26. Price may change.
          </p>
          <a href="#contents-quote" class="inline-flex items-center gap-2 pt-1 text-sm font-bold text-[#141716]">
            <span>Get your quote</span>
            <span class="w-7 h-7 rounded-full bg-[#141716] text-white inline-flex items-center justify-center text-xs">
              &rarr;
            </span>
          </a>
        </div>

        <div class="w-24 h-24 rounded-xl bg-[#E8F7EE] flex items-center justify-center text-3xl shrink-0">
          📘🎧
        </div>
      </section>

      <footer class="pt-4 pb-6 text-center space-y-2 text-[#5C6260]">
        <div class="text-3xl text-[#006A4D]">🐎</div>
        <p class="text-sm font-medium">All caught up</p>
      </footer>

    </main>

    <!-- APPLY TAB VIEW -->
    <div data-pill-nav-target="panel" data-tab="apply" class="hidden">
      <header class="sticky top-0 z-20 bg-[#F3F4F3]/95 backdrop-blur px-4 pt-5 pb-3">
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold tracking-tight">Apply</h1>
          <button type="button" class="p-1 text-[#141716]" aria-label="Profile settings">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 7.5a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.118a7.5 7.5 0 0115 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </button>
        </div>
      </header>

      <% apply_items = [
        { id: "savings", title: "Savings", icon: "🐷", summary: "Compare easy access and fixed-term savings accounts." },
        { id: "investments", title: "Investments", icon: "🐷", summary: "Explore ready-made funds and investment accounts." },
        { id: "pensions", title: "Pensions", icon: "✈", summary: "Review pension options and retirement planning tools." },
        { id: "loans-and-car-finance", title: "Loans and Car finance", icon: "📅", summary: "Check personal loan rates and car finance options." },
        { id: "wealth-management", title: "Wealth Management", icon: "🔒", summary: "Dedicated support and portfolio options for higher balances." },
        { id: "home-insurance", title: "Home Insurance", icon: "🔒", summary: "Get a quote for buildings, contents, or combined home cover." },
        { id: "life-insurance", title: "Life Insurance", icon: "🔒", summary: "Compare term and whole life cover options tailored to your needs." },
        { id: "family-finances", title: "Family Finances", icon: "💳", summary: "Tools and accounts to help manage household budgets and family expenses." },
        { id: "overdrafts", title: "Overdrafts", icon: "£", summary: "Check eligibility or request a change to your arranged overdraft limit." },
        { id: "current-accounts", title: "Current accounts", icon: "📁", summary: "Open a new everyday account or switch your main bank account." },
        { id: "credit-cards", title: "Credit cards", icon: "💳", summary: "See credit card options and check soft-search eligibility." },
        { id: "mortgages", title: "Mortgages", icon: "🏠", summary: "Explore mortgage rates, remortgaging, and borrowing estimates." },
        { id: "motor-insurance", title: "Motor Insurance", icon: "🔒", summary: "Get a quote for car or van cover with optional extras." },
        { id: "pet-insurance", title: "Pet Insurance", icon: "🌐", summary: "Cover vet bills and care costs for cats and dogs." },
        { id: "health-insurance", title: "Health Insurance", icon: "🌐", summary: "Explore private medical cover and wellbeing support." },
        { id: "your-credit-score", title: "Your Credit Score", icon: "£", summary: "View your credit report and tips to keep your score healthy." },
        { id: "business-banking", title: "Business Banking", icon: "🌐", summary: "Accounts and tools designed for sole traders and limited companies." }
      ] %>

      <main class="px-4 pt-1 pb-6 space-y-4">
        <!-- Top 2-column quick action tiles -->
        <div class="grid grid-cols-2 gap-3">
          <button
            type="button"
            class="bg-white rounded-2xl px-4 py-7 border border-black/5 shadow-2xs flex flex-col items-center justify-center text-center hover:bg-gray-50 active:bg-gray-100">
            <span class="w-12 h-12 rounded-full bg-[#A5A6F6] text-[#141716] flex items-center justify-center text-sm font-extrabold mb-4">
              £
            </span>
            <span class="text-base font-bold leading-snug text-[#141716]">
              Manage your overdraft
            </span>
          </button>

          <button
            type="button"
            class="bg-white rounded-2xl px-4 py-7 border border-black/5 shadow-2xs flex flex-col items-center justify-center text-center hover:bg-gray-50 active:bg-gray-100">
            <span class="w-12 h-12 rounded-full bg-[#A5A6F6] text-[#141716] flex items-center justify-center text-base font-bold mb-4">
              ▭
            </span>
            <span class="text-base font-bold leading-snug text-[#141716]">
              Credit card eligibility checker
            </span>
          </button>
        </div>

        <!-- Expandable product list -->
        <div class="space-y-2.5">
          <% apply_items.each do |item| %>
            <div class="bg-white rounded-xl border border-black/5 shadow-2xs overflow-hidden">
              <button
                type="button"
                aria-expanded="false"
                aria-controls="apply-details-<%= item[:id] %>"
                data-action="click->pill-nav#toggleRow"
                class="w-full px-4 py-4 flex items-center justify-between text-left hover:bg-gray-50 active:bg-gray-100">
                <div class="flex items-center gap-4">
                  <span class="w-7 h-7 rounded-md border border-[#141716] flex items-center justify-center text-xs font-bold shrink-0">
                    <%= item[:icon] %>
                  </span>
                  <span class="text-base font-medium text-[#141716]"><%= item[:title] %></span>
                </div>
                <span data-plus-icon class="text-xl font-normal text-[#141716] leading-none px-1">+</span>
              </button>

              <div id="apply-details-<%= item[:id] %>" class="hidden px-4 pb-4 pt-1 border-t border-gray-100 text-sm text-[#5C6260]">
                <p><%= item[:summary] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </main>
    </div>

    <!-- PLACEHOLDER PANELS FOR OTHER TABS -->
    <% %w[save_invest borrow homes insure payments help cards].each do |other_tab| %>
      <main data-pill-nav-target="panel" data-tab="<%= other_tab %>" class="hidden px-4 pt-6">
        <div class="bg-white rounded-2xl p-6 text-center border border-black/5">
          <p class="text-base font-bold capitalize"><%= other_tab.tr("_", " ") %></p>
          <p class="text-sm text-[#5C6260] mt-1">Ready for you to build next.</p>
        </div>
      </main>
    <% end %>

  </div>

  <!-- Bottom Navigation Bar -->
  <nav class="fixed bottom-0 inset-x-0 z-30 pointer-events-none">
    <div class="max-w-md mx-auto bg-white border-t border-gray-200 pointer-events-auto">
      <div class="grid grid-cols-5 text-center">
        <% nav_tabs = [
          { key: "home", label: "Home", icon: "⌂", active: true },
          { key: "apply", label: "Apply", icon: "✋", active: false },
          { key: "payments", label: "Payments", icon: "⇄", active: false },
          { key: "help", label: "Help", icon: "🔍", active: false },
          { key: "cards", label: "Cards", icon: "▭", active: false }
        ] %>

        <% nav_tabs.each do |tab| %>
          <a
            href="#<%= tab[:key] %>"
            data-tab="<%= tab[:key] %>"
            data-pill-nav-target="navItem"
            data-action="click->pill-nav#switchBottomNav"
            class="relative pt-2.5 pb-2 flex flex-col items-center text-xs <%= tab[:active] ? 'font-bold text-[#141716]' : 'font-medium text-[#5C6260] hover:text-[#141716]' %>">
            <span
              data-nav-indicator
              class="absolute top-0 inset-x-3 h-1 rounded-full bg-[#00875A] <%= tab[:active] ? '' : 'hidden' %>"></span>
            <span class="text-base leading-none mb-1"><%= tab[:icon] %></span>
            <span><%= tab[:label] %></span>
          </a>
        <% end %>
      </div>
    </div>
  </nav>

</div>
